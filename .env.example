# Bot account's PAT. Needs: repo (contents + PRs), and the bot account
# must be added as a collaborator (or org member with access) on every
# repo in FACTORY_REPOS so "assign issue to it" and "open PR as it" work.
GITHUB_TOKEN=ghp_xxx
GITHUB_BOT_USERNAME=your-bot-account

# Comma-separated owner/repo list to seed the repo registry with at
# startup (optional -- more can be registered later from the UI).
FACTORY_REPOS=yourorg/repo1,yourorg/repo2

# Local model server (LM Studio, etc.). FACTORY_LOCAL_BASE_URL is how a
# *container* reaches it (host.docker.internal); FACTORY_LOCAL_HOST_BASE_URL
# is how the app itself reaches it directly for "ask" sessions (no container).
# Defaults match this machine's LM Studio setup.
FACTORY_LOCAL_PROVIDER=lmstudio
FACTORY_LOCAL_BASE_URL=http://host.docker.internal:1234/v1
FACTORY_LOCAL_HOST_BASE_URL=http://127.0.0.1:1234/v1
FACTORY_LOCAL_MODEL_KEY=qwen3.8-27b
FACTORY_LOCAL_MODEL_ID=qwen/qwen3.8-27b

# Hosted model providers (optional). Set a key to use that provider, then add
# its models under Settings -> Models. Prefixed with FACTORY_ so a key in your
# shell for something else isn't used. Agents never see these: their calls go
# through Bertha's model relay, which only allows the models you've enabled.
# FACTORY_ANTHROPIC_API_KEY=
# FACTORY_OPENAI_API_KEY=
# FACTORY_OPENROUTER_API_KEY=
# FACTORY_DEEPSEEK_API_KEY=
# FACTORY_GEMINI_API_KEY=
# Any other OpenAI-compatible server (Groq, Together, Ollama, vLLM...). The
# key is optional if the server doesn't need one.
# FACTORY_CUSTOM_NAME=Groq
# FACTORY_CUSTOM_BASE_URL=https://api.groq.com/openai/v1
# FACTORY_CUSTOM_API_KEY=

# How often the GitHub-dependent loop runs (issue discovery, polling
# sleeping sessions' PRs for comments). Local session progress (queued
# -> running, etc.) runs on FACTORY_FAST_POLL_INTERVAL_SECONDS instead,
# so creating a session doesn't wait on this.
FACTORY_POLL_INTERVAL_SECONDS=60
FACTORY_FAST_POLL_INTERVAL_SECONDS=3
FACTORY_SLEEP_AFTER_MINUTES=30
FACTORY_DB_PATH=data/factory.db
FACTORY_AGENT_IMAGE_TAG=factory-agent:latest
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8787
# Commit author. Both default to the GITHUB_BOT_USERNAME account. GitHub
# credits commits to whoever owns the login in a noreply address, so only
# use an address that belongs to you, e.g. <id>+<login>@users.noreply.github.com
# (your ID is at https://api.github.com/users/<login>).
# FACTORY_BOT_NAME=Bertha
# FACTORY_BOT_EMAIL=
